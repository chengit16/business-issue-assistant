{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.ts uno.config.ts vitest.config.ts --max-warnings 0",
    "format:check": "prettier --check src vite.config.ts uno.config.ts vitest.config.ts eslint.config.mjs scripts",
    "format": "prettier --write src vite.config.ts uno.config.ts vitest.config.ts eslint.config.mjs scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "antd": "^6.0.0",
    "axios": "^1.21.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "unocss": "^66.13.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
